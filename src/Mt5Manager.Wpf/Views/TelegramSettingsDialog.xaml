<Window x:Class="Mt5Manager.Wpf.Views.TelegramSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Bot Settings" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Closing="Window_Closing">
    <Grid Margin="26,22,26,24" Width="600">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Telegram Bot" Style="{StaticResource PageTitleStyle}" FontSize="24"/>
            <TextBlock Text="Securely connect a bot for authorized MT5 Algo Trading controls."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel IsEnabled="{Binding CanMutate}">
                <CheckBox Content="Enable Telegram bot" IsChecked="{Binding Enabled}" FontWeight="SemiBold"
                          AutomationProperties.HelpText="Allows the saved bot configuration to run when applied."/>

                <TextBlock Text="Bot Token" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/>
                <TextBlock Text="Token from BotFather. It is encrypted when saved and never displayed in status messages."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,7"/>
                <PasswordBox x:Name="TokenBox" PasswordChanged="TokenBox_PasswordChanged"
                             AutomationProperties.Name="Telegram bot token"/>

                <TextBlock Text="Allowed Chat ID" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/>
                <TextBlock Text="Positive numeric ID of the only private chat authorized to control terminals."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,7"/>
                <TextBox Text="{Binding AllowedChatId,UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Allowed Telegram Chat ID"/>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Connection status" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.Name="Telegram connection state"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Foreground="{StaticResource DangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                </Border>

                <Button Content="Test Connection" Click="Test_Click" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" MinWidth="138" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Remove Configuration" Click="Remove_Click" IsEnabled="{Binding CanMutate}"
                    Style="{StaticResource DangerOutlineButtonStyle}" MinWidth="170"/>
            <Button Grid.Column="2" Content="Cancel" IsCancel="True" MinWidth="96" IsEnabled="{Binding CanMutate}"/>
            <Button Grid.Column="3" Content="Save" Click="Save_Click" IsDefault="True" IsEnabled="{Binding CanMutate}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="104" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
