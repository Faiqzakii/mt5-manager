<Window x:Class="Mt5Manager.Wpf.Views.TelegramSettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Telegram settings" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid Margin="24" Width="580"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="Telegram controls" Style="{StaticResource ObjectTitleStyle}"/><TextBlock Text="Connect one authorized private chat to MT5 Algo Trading controls." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" IsEnabled="{Binding CanMutate}"><CheckBox Content="Enable Telegram bot" IsChecked="{Binding Enabled}" FontWeight="SemiBold" AutomationProperties.HelpText="Allows the saved bot configuration to run when applied."/>
            <TextBlock Text="Bot token" Style="{StaticResource LabelStyle}" Margin="0,16,0,0"/><TextBlock Text="The BotFather token is encrypted when saved and never shown in status messages." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,7"/><PasswordBox x:Name="TokenBox" PasswordChanged="TokenBox_PasswordChanged" AutomationProperties.Name="Telegram bot token"/>
            <TextBlock Text="Allowed chat ID" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/><TextBlock Text="Positive numeric ID of the only private chat authorized to control terminals." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,7"/><TextBox Text="{Binding AllowedChatId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Allowed Telegram chat ID"/>
            <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Connection" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource DangerBrush}" AutomationProperties.LiveSetting="Assertive"/></StackPanel><Button Grid.Column="1" Content="Test connection" Click="Test_Click" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Remove configuration" Click="Remove_Click" IsEnabled="{Binding CanMutate}" Style="{StaticResource DangerOutlineButtonStyle}"/><Button Grid.Column="2" Content="Cancel" IsCancel="True" MinWidth="92" IsEnabled="{Binding CanMutate}"/><Button Grid.Column="3" Content="Save settings" Click="Save_Click" IsDefault="True" IsEnabled="{Binding CanMutate}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="116" Margin="8,0,0,0"/></Grid>
    </Grid>
</Window>
