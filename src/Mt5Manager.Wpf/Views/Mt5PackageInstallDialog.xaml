<Window x:Class="Mt5Manager.Wpf.Views.Mt5PackageInstallDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install EA / Indicator" Height="680" Width="720" MinHeight="560" MinWidth="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="Install EA / Indicator" Style="{StaticResource ObjectTitleStyle}"/><TextBlock Text="Deploy one compiled MT5 package to verified terminal data directories." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
            <TextBlock Text="Compiled package" Style="{StaticResource LabelStyle}"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SourcePath}" IsReadOnly="True" AutomationProperties.Name="Selected EX5 file"/><Button Grid.Column="1" Content="Choose .ex5…" Click="ChooseFile_Click" Margin="8,0,0,0" AutomationProperties.HelpText="Choose a compiled MT5 package"/></Grid>
            <TextBlock Text="Package type" Style="{StaticResource LabelStyle}" Margin="0,18,0,4"/><StackPanel Orientation="Horizontal"><RadioButton Content="Expert Advisor" IsChecked="{Binding IsExpertAdvisor}" GroupName="Kind" MinHeight="40" VerticalContentAlignment="Center"/><RadioButton Content="Indicator" IsChecked="{Binding IsIndicator}" GroupName="Kind" Margin="24,0,0,0" MinHeight="40" VerticalContentAlignment="Center"/></StackPanel>
            <TextBlock Text="Install scope" Style="{StaticResource LabelStyle}" Margin="0,14,0,4"/><RadioButton Content="{Binding SelectedScopeLabel}" IsChecked="{Binding IsSelectedScope}" IsEnabled="{Binding HasSelectedTerminal}" GroupName="Scope" MinHeight="40" VerticalContentAlignment="Center"/><RadioButton Content="All currently listed terminals" IsChecked="{Binding IsAllScope}" GroupName="Scope" MinHeight="40" VerticalContentAlignment="Center"/>
            <Border Style="{StaticResource WarningPanelStyle}" Margin="0,14,0,0"><TextBlock Text="Existing files with the same name will be overwritten. Only the chosen file is copied." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/></Border>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Margin="0,16,0,0" AutomationProperties.Name="Package installation progress"/>
            <Border Margin="0,14,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
            <Border Margin="0,14,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SubtlePanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Summary}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><ItemsControl ItemsSource="{Binding Outcomes}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Failed"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Success}" Value="True"><Setter Property="Text" Value="Installed"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0"><Grid><Button Content="Close" IsCancel="True" HorizontalAlignment="Left" MinWidth="88"/><Button Content="Install package" IsEnabled="{Binding CanInstall}" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="132"/></Grid></Border>
    </Grid>
</Window>