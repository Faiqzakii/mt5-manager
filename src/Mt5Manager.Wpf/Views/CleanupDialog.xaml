<Window x:Class="Mt5Manager.Wpf.Views.CleanupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cleanup terminal data" Height="520" Width="620" WindowStartupLocation="CenterOwner" Closing="Window_Closing" Loaded="Window_Loaded">
 <DockPanel Margin="16"><TextBlock DockPanel.Dock="Top" Text="Review and clean terminal data" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock DockPanel.Dock="Top" Text="Only verified data directories can be cleaned. Select categories after reviewing the preview." TextWrapping="Wrap" Margin="0,0,0,12"/>
 <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" MinHeight="44" VerticalContentAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <CheckBox DockPanel.Dock="Top" Content="I understand the selected data will be permanently deleted" IsChecked="{Binding IsDestructiveConfirmed}" MinHeight="44" VerticalContentAlignment="Center" AutomationProperties.Name="Confirm permanent cleanup"/>
 <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}" Height="8" Margin="0,4" AutomationProperties.Name="Cleanup progress"/>
 <TextBox Text="{Binding Preview}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" Margin="0,8" AutomationProperties.Name="Cleanup preview"/><TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap"/><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,8"/>
 <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" IsCancel="True" MinWidth="88" Height="44" Margin="4"/><Button Content="Prepare cleanup" IsEnabled="{Binding CanPrepare}" Click="Prepare_Click" MinWidth="120" Height="44" Margin="4"/><Button Content="Continue cleanup" IsEnabled="{Binding CanContinue}" Click="Continue_Click" MinWidth="120" Height="44" Margin="4"/><Button Content="Force and continue" Visibility="{Binding RequiresForceConfirmation,Converter={StaticResource BooleanToVisibilityConverter}}" Click="Force_Click" MinWidth="140" Height="44" Margin="4"/></StackPanel>
 </DockPanel></Window>
