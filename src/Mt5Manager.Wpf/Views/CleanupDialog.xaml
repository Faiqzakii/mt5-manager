<Window x:Class="Mt5Manager.Wpf.Views.CleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup terminal data" Height="720" Width="720" MinHeight="620" MinWidth="620"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Clean terminal data" Style="{StaticResource PageTitleStyle}" FontSize="24"/>
            <TextBlock Text="Review exactly what will be removed before the terminal is stopped."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1  Choose data categories" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Only verified terminal data directories are eligible."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource CheckRowStyle}" Margin="0,0,0,8"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WarningPanelStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2  Confirm permanent deletion" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="This action cannot be undone. Files outside the selected categories will not be touched."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <CheckBox Content="I understand the selected data will be permanently deleted"
                                  IsChecked="{Binding IsDestructiveConfirmed}" Style="{StaticResource CheckRowStyle}"
                                  AutomationProperties.Name="Confirm permanent cleanup"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="3  Review cleanup preview" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="The preview updates from the verified terminal storage."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                        <TextBox Text="{Binding Preview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="110" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceSubtleBrush}" FontFamily="Consolas"
                                 AutomationProperties.Name="Cleanup preview"/>
                    </StackPanel>
                </Border>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"
                             Height="6" Margin="2,0,2,14" AutomationProperties.Name="Cleanup progress"/>

                <Border Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <StackPanel><TextBlock Text="Action needed" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SuccessPanelStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding ResultText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <StackPanel><TextBlock Text="Cleanup result" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,6,0,0">
            <Grid>
                <Button Content="Close" IsCancel="True" MinWidth="88" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Prepare cleanup" IsEnabled="{Binding CanPrepare}" Click="Prepare_Click" MinWidth="132"/>
                    <Button Content="Continue cleanup" IsEnabled="{Binding CanContinue}" Click="Continue_Click"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="138" Margin="8,0,0,0"/>
                    <Button Content="Force and continue" IsEnabled="{Binding CanForceContinue}"
                            Visibility="{Binding RequiresForceConfirmation,Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="Force_Click" Style="{StaticResource DangerButtonStyle}" MinWidth="150" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
