<Window x:Class="Mt5Manager.Wpf.Views.ManualRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register terminal" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="26,22,26,24" Width="580">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Register a terminal" Style="{StaticResource PageTitleStyle}" FontSize="24"/>
            <TextBlock Text="Add an MT5 installation and verify its local data directory."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Display name" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="A recognizable label for this terminal."
                           Style="{StaticResource CaptionStyle}" Margin="0,3,0,7"/>
                <TextBox x:Name="NameBox" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Executable path" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/>
                <TextBlock Text="Full path to the terminal64.exe executable."
                           Style="{StaticResource CaptionStyle}" Margin="0,3,0,7"/>
                <TextBox x:Name="ExeBox" Text="{Binding ExecutablePath,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Full path to terminal64.exe"/>

                <TextBlock Text="Data directory" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/>
                <TextBlock Text="Existing MetaTrader data directory used for storage inspection and cleanup."
                           Style="{StaticResource CaptionStyle}" Margin="0,3,0,7" TextWrapping="Wrap"/>
                <TextBox x:Name="DataBox" Text="{Binding DataDirectory,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Existing MetaTrader data directory"/>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Validation" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="96"/>
                <Button Content="Register terminal" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Register_Click"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="148" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
