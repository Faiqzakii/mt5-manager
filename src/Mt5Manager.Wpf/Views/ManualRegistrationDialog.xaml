<Window x:Class="Mt5Manager.Wpf.Views.ManualRegistrationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Register terminal" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24" Width="560"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="Register terminal" Style="{StaticResource ObjectTitleStyle}"/><TextBlock Text="Add an MT5 installation and verify its local data directory." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="Display name" Style="{StaticResource LabelStyle}"/><TextBlock Text="Use a name you can recognize in the terminal list." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7"/><TextBox x:Name="NameBox" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal display name"/>
            <TextBlock Text="Executable path" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/><TextBlock Text="Full path to terminal64.exe." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7"/><TextBox x:Name="ExeBox" Text="{Binding ExecutablePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal executable path"/>
            <TextBlock Text="Data directory" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/><TextBlock Text="Existing MetaTrader data directory used for bridge installation and storage operations." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7" TextWrapping="Wrap"/><TextBox x:Name="DataBox" Text="{Binding DataDirectory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal data directory"/>
            <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Validation" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" MinWidth="92"/><Button Content="Register terminal" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Register_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="144" Margin="8,0,0,0"/></StackPanel></Border>
    </Grid>
</Window>
