<Window x:Class="Mt5Manager.Wpf.Views.ManualRegistrationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Register terminal" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="16" Width="520"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Label Content="Display name" Target="{Binding ElementName=NameBox}"/><TextBox x:Name="NameBox" Grid.Column="1" Height="36" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/>
 <Label Grid.Row="1" Content="Executable path" Target="{Binding ElementName=ExeBox}"/><TextBox x:Name="ExeBox" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,8,0,0" Text="{Binding ExecutablePath,UpdateSourceTrigger=PropertyChanged}" ToolTip="Full path to terminal64.exe"/>
 <Label Grid.Row="2" Content="Data directory" Target="{Binding ElementName=DataBox}"/><TextBox x:Name="DataBox" Grid.Row="2" Grid.Column="1" Height="36" Margin="0,8,0,0" Text="{Binding DataDirectory,UpdateSourceTrigger=PropertyChanged}" ToolTip="Existing MetaTrader data directory"/>
 <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,12"/>
 <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" MinWidth="88" Height="44" Margin="4"/><Button Content="Register" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Register_Click" MinWidth="88" Height="44" Margin="4"/></StackPanel>
 </Grid></Window>
