<Window x:Class="Mt5Manager.Wpf.Views.ManualRegistrationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Register terminal" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24" Width="560"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="Register terminal" Style="{StaticResource ObjectTitleStyle}"/><TextBlock Text="Add an MT5 installation and verify its data folder before saving." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="Terminal name" Style="{StaticResource LabelStyle}"/><TextBlock Text="Choose a recognizable name, such as Broker — Demo." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7"/><TextBox x:Name="NameBox" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal display name"/>
            <TextBlock Text="Executable path" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/><TextBlock Text="Choose terminal64.exe or terminal.exe from the MT5 installation, not its data folder." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7" TextWrapping="Wrap"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse executable…" Click="BrowseExecutable_Click" AutomationProperties.Name="Browse for MT5 executable" AutomationProperties.HelpText="Choose terminal64.exe or terminal.exe from the installation folder" Margin="8,0,0,0"/><TextBox x:Name="ExeBox" Text="{Binding ExecutablePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal executable path"/>
            </DockPanel>
            <TextBlock Text="Data directory" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/><TextBlock Text="In MT5 choose File → Open Data Folder. Select that existing folder, not the installation folder." Style="{StaticResource CaptionStyle}" Margin="0,3,0,7" TextWrapping="Wrap"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse data folder…" Click="BrowseData_Click" AutomationProperties.Name="Browse for existing MT5 data folder" AutomationProperties.HelpText="Select the folder opened by MT5 File → Open Data Folder" Margin="8,0,0,0"/><TextBox x:Name="DataBox" Text="{Binding DataDirectory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal data directory"/></DockPanel>
            <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Validation" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" MinWidth="92"/><Button Content="Register terminal" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Register_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="144" Margin="8,0,0,0"/></StackPanel></Border>
    </Grid>
</Window>
