<Window x:Class="Mt5Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MT5 Manager" Icon="Assets/mt5-manager.ico" Height="780" Width="1200" MinHeight="620" MinWidth="900" Loaded="Window_Loaded" Closed="Window_Closed" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Menu Grid.Row="0" Padding="18,5" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Application menu">
            <MenuItem Header="_Terminal"><MenuItem Header="_Scan terminals" Command="{Binding RefreshCommand}"/><MenuItem Header="_Register terminal" Click="Manual_Click"/></MenuItem>
            <MenuItem Header="_Tools"><MenuItem Header="_Scheduler" Click="Scheduler_Click"/><MenuItem Header="_Install EA / Indicator" Click="PackageInstall_Click"/></MenuItem>
            <MenuItem Header="_Settings"><MenuItem Header="_Telegram" Click="Telegram_Click"/></MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="_Getting started" Click="GettingStarted_Click"/></MenuItem>
        </Menu>
        <Border Grid.Row="1" Margin="24,14,24,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
<TabControl Grid.Row="2" Margin="18,12" AutomationProperties.Name="Workspace tabs">
<TabItem Header="_Terminals"><Grid Margin="6,12,6,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search terminals" ToolTip="Search name, account, server or path"/>
<ComboBox x:Name="StateFilterComboBox" Grid.Column="1" ItemsSource="{Binding StateFilters}" SelectedItem="{Binding StateFilter}" Width="150" Margin="16,0" AutomationProperties.Name="Filter terminal state"/>
<Menu Grid.Column="2" VerticalAlignment="Center" MinWidth="{Binding ActualWidth,ElementName=StateFilterComboBox}" Height="{Binding ActualHeight,ElementName=StateFilterComboBox}" Padding="0" Background="{Binding Background,ElementName=StateFilterComboBox}" Foreground="{Binding Foreground,ElementName=StateFilterComboBox}" BorderBrush="{Binding BorderBrush,ElementName=StateFilterComboBox}" BorderThickness="{Binding BorderThickness,ElementName=StateFilterComboBox}" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Batch operations">
<MenuItem Header="_Batch operations" Padding="{Binding Padding,ElementName=StateFilterComboBox}" Height="{Binding ActualHeight,ElementName=StateFilterComboBox}" MinWidth="{Binding ActualWidth,ElementName=StateFilterComboBox}" VerticalContentAlignment="Center"><MenuItem.Style><Style TargetType="MenuItem"><Setter Property="IsEnabled" Value="False"/><Setter Property="Foreground" Value="{Binding Foreground,ElementName=StateFilterComboBox}"/><Setter Property="Background" Value="{Binding Background,ElementName=StateFilterComboBox}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasBatchSelection}" Value="True"/><Condition Binding="{Binding IsBatchIdle}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></MenuItem.Style><MenuItem.HeaderTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AccessText Text="{Binding}" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=MenuItem}}" VerticalAlignment="Center" Margin="10,0,4,0"/></Grid></DataTemplate></MenuItem.HeaderTemplate><MenuItem Header="_Start selected" Tag="Start" Click="Batch_Click"/><MenuItem Header="St_op selected…" Tag="Stop" Click="Batch_Click"/><MenuItem Header="_Restart selected…" Tag="Restart" Click="Batch_Click"/><MenuItem Header="_Update selected one by one…" Tag="Update" Click="Batch_Click"/><Separator/><MenuItem Header="_Clear selection" Command="{Binding ClearSelectionCommand}"/></MenuItem></Menu>
<ProgressBar Grid.Column="3" IsIndeterminate="True" Width="80" Height="4" Margin="16,0,0,0" Visibility="{Binding IsRefreshing,Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Scanning terminals"/></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="240"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="480"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,16,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Terminals" Style="{StaticResource SectionTitleStyle}"/><Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Padding="8,2"><TextBlock Text="{Binding Terminals.Count}" Style="{StaticResource CaptionStyle}"/></Border></Grid>
                    <Grid Grid.Row="1"><TextBlock Text="{Binding EmptyStateText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="28" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Terminals.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ListBox ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal,Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Registered terminals">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="12,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PrimarySoftBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsBatchSelected,Mode=TwoWay}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,8,0" AutomationProperties.Name="{Binding DisplayName}" ToolTip="Select this terminal for batch operations"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding AccountSummary}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountSummary}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Background="Transparent" Width="6" ResizeDirection="Columns" AutomationProperties.Name="Resize terminal list"/>
            <Grid Grid.Column="2" Margin="14,0,0,0">
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTerminal}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding SelectedTerminal}"><ContentControl.ContentTemplate><DataTemplate>
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource ObjectTitleStyle}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Border Style="{StaticResource StatusPillStyle}"><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Margin="0,0,7,0"/><TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border><TextBlock Text="PID" Style="{StaticResource CaptionStyle}" Margin="12,5,5,0"/><TextBlock Text="{Binding ProcessId,TargetNullValue=—}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"/><Button Content="Restart" Command="{Binding RestartCommand}" Margin="8,0,0,0"/></StackPanel></Grid>
                            <TextBlock Text="{Binding ReadinessGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Account and bridge" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding AccountSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding AlgoSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding BridgeInstallSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Install bridge" Command="{Binding InstallBridgeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding IsBridgeInstallVisible,Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Global Algo Trading affects every EA in this terminal." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button Content="Enable Algo" Command="{Binding EnableAlgoCommand}" Margin="0,9,0,0"/><Button Content="Disable Algo" Command="{Binding DisableAlgoCommand}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Expander Header="Terminal details" IsExpanded="False"><StackPanel><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Executable" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Data directory" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></Expander></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Expander Header="Storage" IsExpanded="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StorageSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button Content="Inspect storage" Command="{Binding InspectStorageCommand}"/><Button Content="Cleanup data…" IsEnabled="{Binding CanCleanup}" Click="Cleanup_Click" Style="{StaticResource DangerOutlineButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Expander></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Expander Header="Recent activity" IsExpanded="False"><StackPanel><Grid Margin="0,9,0,0"><TextBlock Text="No operations recorded yet." Foreground="{StaticResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OperationHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox ItemsSource="{Binding OperationHistory}" MaxHeight="150" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Operation}" FontWeight="SemiBold" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></StackPanel></Expander></Border>
                            <Border Margin="0,16,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
                        </StackPanel>
                    </DataTemplate></ContentControl.ContentTemplate></ContentControl></ScrollViewer>
                </Border>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTerminal}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"><TextBlock Text="Choose a terminal" Style="{StaticResource ObjectTitleStyle}" HorizontalAlignment="Center"/><TextBlock Text="Select a terminal to inspect its state, control its session, install the bridge, or manage storage." Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid>
        </Grid></Grid></TabItem>
<TabItem Header="_Batch results"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding BatchStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" Margin="0,12" Visibility="{Binding IsBatchBusy,Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Batch in progress"/>
<Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding BatchResults}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><TextBlock TextWrapping="Wrap"><Run Text="{Binding TerminalName}"/><Run Text=" — "/><Run Text="{Binding Outcome}"/><Run Text=": "/><Run Text="{Binding Message}"/></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="No batch results yet. Select terminals on the Terminals tab, then choose a selected-terminal action. Results appear here as each operation finishes." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BatchResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></TabItem>
<TabItem x:Name="GettingStartedTab" Header="_Getting started"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
<TextBlock Text="Find and register terminals" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Use Terminal → Scan terminals to discover installations. To add one manually, choose Terminal → Register terminal and provide terminal64.exe and its existing data folder. In MT5, File → Open Data Folder identifies the correct folder." TextWrapping="Wrap"/>
<TextBlock Text="Inspect one terminal" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="Select a terminal row to inspect readiness, account connection, Algo Trading and storage. Starting a terminal opens its session; it does not guarantee broker connection or enable Algo Trading. Install the bridge from the terminal detail pane to connect MT5 to this utility." TextWrapping="Wrap"/>
<TextBlock Text="Run selected-terminal actions" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="Tick terminal checkboxes to enable Batch operations beside the state filter, then choose Start, Stop, Restart or Clear selection. Clicking a terminal name only opens its details. The menu stays visible and is disabled while scanning or running a batch. Search and filters do not clear checked targets; the status bar indicates hidden selections. Stop and restart require confirmation because running sessions and expert advisors are interrupted. The batch uses the confirmed selection snapshot; results remain on the Batch results tab without moving you away from your current tab." TextWrapping="Wrap"/>
<TextBlock Text="Configure tools" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="Tools → Scheduler manages Algo Trading schedules. Tools → Install EA / Indicator opens package installation. Settings → Telegram opens Telegram configuration. Review each dialog's target terminals and safety guidance before applying changes." TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem></TabControl>
<Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource TextSecondaryBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Batch running · " Visibility="{Binding IsBatchBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding BatchStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Grid></Border>
</Grid></Window>