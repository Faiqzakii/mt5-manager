<Window x:Class="Mt5Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MT5 Manager" Height="620" Width="980" MinHeight="420" MinWidth="720" Loaded="Window_Loaded" Closed="Window_Closed">
 <DockPanel Margin="16">
  <TextBlock DockPanel.Dock="Top" Text="MT5 Terminal Manager" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
   <TextBox Width="360" Height="44" VerticalContentAlignment="Center" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search terminals" ToolTip="Search by terminal name or executable path"/>
   <Button Content="Scan terminals" Command="{Binding RefreshCommand}" MinWidth="120" Height="44" Margin="8,0,0,0" AutomationProperties.Name="Scan terminals"/>
   <Button Content="Register manually" Click="Manual_Click" MinWidth="140" Height="44" Margin="8,0,0,0"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <ListView ItemsSource="{Binding Terminals}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Registered terminals">
   <ListView.ItemTemplate><DataTemplate><Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StorageSummary}"/><TextBlock Text="{Binding LastResult}"/><TextBlock Text="{Binding Error}" Foreground="Firebrick"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding State}"/><TextBlock Text=" · PID: "/><TextBlock Text="{Binding ProcessId}"/></StackPanel></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Start" Command="{Binding StartCommand}" MinWidth="72" Height="44" Margin="4"/><Button Content="Stop" Command="{Binding StopCommand}" MinWidth="72" Height="44" Margin="4"/><Button Content="Restart" Command="{Binding RestartCommand}" MinWidth="76" Height="44" Margin="4"/><Button Content="Cleanup…" IsEnabled="{Binding CanCleanup}" Click="Cleanup_Click" MinWidth="88" Height="44" Margin="4"/></StackPanel>
    </Grid></Border></DataTemplate></ListView.ItemTemplate>
  </ListView>
 </DockPanel>
</Window>
