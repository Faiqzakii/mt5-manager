<Window x:Class="Mt5Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MT5 Manager" Icon="Assets/mt5-manager.ico" Height="780" Width="1200" MinHeight="620" MinWidth="900" Loaded="Window_Loaded" Closed="Window_Closed" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="Assets/mt5-manager-logo.png" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="MT5 Manager logo"/>
                <StackPanel Grid.Column="1"><TextBlock Text="MT5 Manager" Style="{StaticResource ObjectTitleStyle}"/><TextBlock Text="Local terminal operations" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Telegram" Click="Telegram_Click" Style="{StaticResource QuietButtonStyle}" AutomationProperties.HelpText="Configure Telegram bot controls"/>
                    <Button Content="Scheduler" Click="Scheduler_Click" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" AutomationProperties.HelpText="Manage recurring Algo Trading schedules"/>
                    <Button Content="Install EA / Indicator" Click="PackageInstall_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.HelpText="Install one compiled EX5 package"/>
                    <Button Content="Register terminal" Click="Manual_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search terminals" ToolTip="Search by terminal name or executable path" MaxWidth="480" HorizontalAlignment="Stretch"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" Height="4" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding IsRefreshing,Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Scanning terminals"/>
                <Button Grid.Column="2" Content="Scan terminals" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Scan terminals"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="24,14,24,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
        <Grid Grid.Row="3" Margin="24,16,24,24"><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="540"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,16,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Terminals" Style="{StaticResource SectionTitleStyle}"/><Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Padding="8,2"><TextBlock Text="{Binding Terminals.Count}" Style="{StaticResource CaptionStyle}"/></Border></Grid>
                    <Grid Grid.Row="1"><TextBlock Text="No terminals found. Scan this computer or register a terminal manually." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="28" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Terminals.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ListBox ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal,Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Registered terminals">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="12,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PrimarySoftBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource PrimaryBrush}" CornerRadius="2" Margin="0,2,10,2"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding State}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="  ·  PID " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ProcessId,TargetNullValue=—}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><TextBlock Text="{Binding AccountSummary}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountSummary}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Background="Transparent" Width="6" ResizeDirection="Columns" AutomationProperties.Name="Resize terminal list"/>
            <Grid Grid.Column="2" Margin="14,0,0,0">
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTerminal}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding SelectedTerminal}"><ContentControl.ContentTemplate><DataTemplate>
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource ObjectTitleStyle}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Border Style="{StaticResource StatusPillStyle}"><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Margin="0,0,7,0"/><TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border><TextBlock Text="PID" Style="{StaticResource CaptionStyle}" Margin="12,5,5,0"/><TextBlock Text="{Binding ProcessId,TargetNullValue=—}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"/><Button Content="Restart" Command="{Binding RestartCommand}" Margin="8,0,0,0"/></StackPanel></Grid>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Account and bridge" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding AccountSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding AlgoSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding BridgeInstallSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Install bridge" Command="{Binding InstallBridgeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding IsBridgeInstallVisible,Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Global Algo Trading affects every EA in this terminal." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button Content="Enable Algo" Command="{Binding EnableAlgoCommand}" Margin="0,9,0,0"/><Button Content="Disable Algo" Command="{Binding DisableAlgoCommand}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Terminal details" Style="{StaticResource SectionTitleStyle}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Executable" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Data directory" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Storage" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding StorageSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button Content="Inspect storage" Command="{Binding InspectStorageCommand}"/><Button Content="Cleanup data…" IsEnabled="{Binding CanCleanup}" Click="Cleanup_Click" Style="{StaticResource DangerOutlineButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Recent activity" Style="{StaticResource SectionTitleStyle}"/><Grid Margin="0,9,0,0"><TextBlock Text="No operations recorded yet." Foreground="{StaticResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OperationHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox ItemsSource="{Binding OperationHistory}" MaxHeight="150" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Operation}" FontWeight="SemiBold" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></StackPanel></Border>
                            <Border Margin="0,16,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
                        </StackPanel>
                    </DataTemplate></ContentControl.ContentTemplate></ContentControl></ScrollViewer>
                </Border>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTerminal}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"><TextBlock Text="Choose a terminal" Style="{StaticResource ObjectTitleStyle}" HorizontalAlignment="Center"/><TextBlock Text="Select a terminal to inspect its state, control its session, install the bridge, or manage storage." Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
