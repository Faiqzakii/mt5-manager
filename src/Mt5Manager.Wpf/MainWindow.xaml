<Window x:Class="Mt5Manager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MT5 Manager" Height="760" Width="1180" MinHeight="560" MinWidth="820"
        Loaded="Window_Loaded" Closed="Window_Closed" WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MT5 Manager" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Monitor terminal status, control sessions, and safely manage local data."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="LOCAL WORKSTATION" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Find a terminal" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search terminals"
                             ToolTip="Search by terminal name or executable path"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Scan terminals" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="132" Margin="12,23,0,0"
                        AutomationProperties.Name="Scan terminals"/>
                <Button Grid.Column="2" Content="Register terminal" Click="Manual_Click"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="148" Margin="10,23,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="8" Height="8" Background="{StaticResource DangerBrush}" CornerRadius="4" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ListView Grid.Row="3" ItemsSource="{Binding Terminals}" Background="Transparent" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Registered terminals">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,14"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemFocus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemFocus" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12" Padding="9,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="7" Height="7" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding State}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="PID" Style="{StaticResource CaptionStyle}" Margin="12,4,5,0"/>
                                        <TextBlock Text="{Binding ProcessId,TargetNullValue=—}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="76"/>
                                    <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="76" Margin="8,0,0,0"/>
                                    <Button Content="Restart" Command="{Binding RestartCommand}" MinWidth="82" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,0,7,0">
                                    <StackPanel><TextBlock Text="EXECUTABLE" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SubtlePanelStyle}" Margin="7,0,0,0">
                                    <StackPanel><TextBlock Text="DATA DIRECTORY" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE ACCOUNT" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AccountSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding AlgoSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="Install Mt5ManagerBridge.mq5 in each terminal to expose account and Algo Trading state." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                                    <TextBlock Text="GLOBAL ALGO TRADING" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Enable Algo" Command="{Binding EnableAlgoCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="102"/>
                                        <Button Content="Disable Algo" Command="{Binding DisableAlgoCommand}" Style="{StaticResource DangerOutlineButtonStyle}" MinWidth="102" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding StorageSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LastResult}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Cleanup data…" IsEnabled="{Binding CanCleanup}" Click="Cleanup_Click"
                                        Style="{StaticResource DangerOutlineButtonStyle}" MinWidth="126" Margin="18,0,0,0"/>
                            </Grid>

                            <Border Grid.Row="4" Margin="0,14,0,0">
                                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
